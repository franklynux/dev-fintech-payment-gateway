{
  "name": "payment-gateway-proxy",
  "version": "1.0.0",
  "main": "src/app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --runInBand",
    "test:services": "jest tests/unit/services --coverage",
    "test:controllers": "jest tests/unit/controllers --coverage",
    "test:utils": "jest tests/unit/utils --coverage",
    "test:middleware": "jest tests/unit/middleware --coverage",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:performance": "node tests/performance/loadTest.js",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "jest tests/e2e --runInBand --forceExit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "pretest": "npm run lint",
    "posttest": "npm run audit",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "joi": "^17.9.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "crypto": "^1.0.1",
    "bull": "^4.0.0",
    "express-validator": "^6.15.0",
    "express-rate-limit": "^7.1.0",
    "redis": "^4.6.0",
    "rate-limit-redis": "4.3.1",
    "sequelize": "^6.32.1",
    "pg": "8.16.3",
    "uuid": "^9.0.0",
    "response-time": "^2.0.0",
    "prom-client": "^14.2.0",
    "pino": "^8.15.0",
    "pino-http": "^8.3.0",
    "stripe": "^13.0.0",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@godaddy/terminus": "^2.1.1",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "jest": "^30.2.0",
    "supertest": "^6.3.0",
    "eslint": "^8.50.0",
    "docker-compose": "^1.2.0"
  }
}
